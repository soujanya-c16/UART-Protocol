`timescale 1ns / 1ps

module uart_loopback_tb;



reg clk;
reg rst;
reg wr_en;
reg [7:0] data_in;

wire tx;
wire busy;

wire [7:0] data_out;
wire done;

//--------------------------------------------------
// UART Transmitter
//--------------------------------------------------
uart_tx_top TX(

    .clk(clk),
    .rst(rst),
    .wr_en(wr_en),
    .data_in(data_in),
    .tx(tx),
    .busy(busy)

);

//--------------------------------------------------
// UART Receiver
//--------------------------------------------------
uart_rx_top RX(

    .clk(clk),
    .rst(rst),
    .rx(tx),          // Loopback Connection

    .data_out(data_out),
    .done(done)

);

//--------------------------------------------------
// Clock Generation (100 MHz)
//--------------------------------------------------
always #5 clk = ~clk;

//--------------------------------------------------
// Test Sequence
//--------------------------------------------------
initial
begin

    clk = 0;
    rst = 1;
    wr_en = 0;
    data_in = 8'h00;

    // Reset
    #20;
    rst = 0;

    //--------------------------------------------------
    // Send First Byte
    //--------------------------------------------------
    @(posedge clk);
    data_in = 8'hA5;
    wr_en = 1;

    @(posedge clk);
    wr_en = 0;

    wait(done);

    #100;

    //--------------------------------------------------
    // Send Second Byte
    //--------------------------------------------------
    @(posedge clk);
    data_in = 8'h3C;
    wr_en = 1;

    @(posedge clk);
    wr_en = 0;

    wait(done);

    #100;

    //--------------------------------------------------
    // End Simulation
    //--------------------------------------------------
    $finish;

end

endmodule
